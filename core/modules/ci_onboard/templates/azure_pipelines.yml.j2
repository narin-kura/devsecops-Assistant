# ---------------------------------------------------------------
# Azure Pipelines — Auto-generated by DevSecOps Assistant
# ---------------------------------------------------------------

trigger:
  branches:
    include:
      - {{ deploy_branch }}

pr:
  branches:
    include:
      - {{ deploy_branch }}

{% if docker_image %}
pool:
  vmImage: 'ubuntu-latest'

container: {{ docker_image }}
{% else %}
pool:
  vmImage: 'ubuntu-latest'
{% endif %}

{% if cache_paths %}
variables:
  CACHE_RESTORED: 'false'
{% endif %}

stages:
  # ==========================  BUILD & TEST  ==========================
  - stage: Build
    displayName: 'Build & Test'
    jobs:
      - job: BuildJob
        displayName: 'Build, Lint & Test'
        steps:
          - checkout: self
            fetchDepth: 1

{% if install_cmd %}
          - script: {{ install_cmd }}
            displayName: 'Install dependencies'
{% endif %}

{% if build_cmd %}
          - script: {{ build_cmd }}
            displayName: 'Build'
{% endif %}

{% if has_lint and lint_cmd %}
          - script: {{ lint_cmd }}
            displayName: 'Lint'
            continueOnError: true
{% endif %}

{% if has_tests and test_cmd %}
          - script: {{ test_cmd }}
            displayName: 'Run tests'
{% endif %}

{% if has_security_scan and security_cmd %}
  # ==========================  SECURITY  ==========================
  - stage: Security
    displayName: 'Security Scan'
    dependsOn: Build
    jobs:
      - job: SecurityScan
        displayName: 'Dependency vulnerability scan'
        steps:
          - checkout: self

{% if install_cmd %}
          - script: {{ install_cmd }}
            displayName: 'Install dependencies'
{% endif %}

          - script: {{ security_cmd }}
            displayName: 'Security scan'
            continueOnError: true
{% endif %}

{% if has_docker %}
  # ==========================  DOCKER  ==========================
  - stage: Docker
    displayName: 'Docker Build'
    dependsOn: Build
    condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/{{ deploy_branch }}'))
    jobs:
      - job: DockerBuild
        displayName: 'Build Docker image'
        steps:
          - checkout: self

          - script: |
              docker build -t app:$(Build.BuildId) .
              echo "Docker image built successfully"
            displayName: 'Docker build'
{% endif %}
