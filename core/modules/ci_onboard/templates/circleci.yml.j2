# ---------------------------------------------------------------
# CircleCI Config — Auto-generated by DevSecOps Assistant
# ---------------------------------------------------------------
version: 2.1

{% if docker_image %}
executors:
  default:
    docker:
      - image: {{ docker_image }}
    working_directory: ~/project
{% endif %}

jobs:
  build-and-test:
{% if docker_image %}
    executor: default
{% else %}
    docker:
      - image: cimg/base:current
{% endif %}

    steps:
      - checkout

{% if cache_paths %}
      - restore_cache:
          keys:
            - deps-{{ language }}-{% raw %}{{ checksum "{% endraw %}{% if language == 'python' %}requirements.txt{% elif language in ('javascript', 'typescript') %}package-lock.json{% elif language == 'java' and framework != 'gradle' %}pom.xml{% elif language == 'go' %}go.sum{% elif language == 'rust' %}Cargo.lock{% elif language == 'ruby' %}Gemfile.lock{% else %}README.md{% endif %}{% raw %}" }}{% endraw %}

{% endif %}
{% if install_cmd %}
      - run:
          name: Install dependencies
          command: {{ install_cmd }}
{% endif %}

{% if cache_paths %}
      - save_cache:
          paths:
{% for cp in cache_paths %}
            - {{ cp }}
{% endfor %}
          key: deps-{{ language }}-{% raw %}{{ checksum "{% endraw %}{% if language == 'python' %}requirements.txt{% elif language in ('javascript', 'typescript') %}package-lock.json{% elif language == 'java' and framework != 'gradle' %}pom.xml{% elif language == 'go' %}go.sum{% elif language == 'rust' %}Cargo.lock{% elif language == 'ruby' %}Gemfile.lock{% else %}README.md{% endif %}{% raw %}" }}{% endraw %}

{% endif %}
{% if build_cmd %}
      - run:
          name: Build
          command: {{ build_cmd }}
{% endif %}

{% if has_lint and lint_cmd %}
      - run:
          name: Lint
          command: {{ lint_cmd }}
{% endif %}

{% if has_tests and test_cmd %}
      - run:
          name: Run tests
          command: {{ test_cmd }}
{% endif %}

{% if has_security_scan and security_cmd %}
  security-scan:
{% if docker_image %}
    executor: default
{% else %}
    docker:
      - image: cimg/base:current
{% endif %}
    steps:
      - checkout
{% if install_cmd %}
      - run:
          name: Install dependencies
          command: {{ install_cmd }}
{% endif %}
      - run:
          name: Security scan
          command: {{ security_cmd }}
          when: always
{% endif %}

{% if has_docker %}
  docker-build:
    machine:
      image: ubuntu-2204:current
    steps:
      - checkout
      - run:
          name: Build Docker image
          command: |
            docker build -t app:${CIRCLE_BUILD_NUM} .
            echo "Docker image built successfully"
{% endif %}

workflows:
  ci-cd:
    jobs:
      - build-and-test
{% if has_security_scan and security_cmd %}
      - security-scan:
          requires:
            - build-and-test
{% endif %}
{% if has_docker %}
      - docker-build:
          requires:
            - build-and-test
          filters:
            branches:
              only: {{ deploy_branch }}
{% endif %}
