// ---------------------------------------------------------------
// Jenkinsfile — Auto-generated by DevSecOps Assistant
// ---------------------------------------------------------------
pipeline {
    agent {
{% if docker_image %}
        docker {
            image '{{ docker_image }}'
        }
{% else %}
        any
{% endif %}
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
{% if install_cmd %}
        stage('Install') {
            steps {
                sh '{{ install_cmd }}'
            }
        }
{% endif %}

{% if build_cmd %}
        stage('Build') {
            steps {
                sh '{{ build_cmd }}'
            }
        }
{% endif %}

{% if has_lint and lint_cmd %}
        stage('Lint') {
            steps {
                sh '{{ lint_cmd }}'
            }
        }
{% endif %}

{% if has_tests and test_cmd %}
        stage('Test') {
            steps {
                sh '{{ test_cmd }}'
            }
        }
{% endif %}

{% if has_security_scan and security_cmd %}
        stage('Security Scan') {
            steps {
                sh '{{ security_cmd }}'
            }
        }
{% endif %}

{% if has_docker %}
        stage('Docker Build') {
            when {
                branch '{{ deploy_branch }}'
            }
            steps {
                sh 'docker build -t app:${BUILD_NUMBER} .'
            }
        }
{% endif %}
    }

    post {
        always {
            cleanWs()
        }
        failure {
            echo 'Pipeline failed — check logs above.'
        }
        success {
            echo 'Pipeline completed successfully.'
        }
    }
}
