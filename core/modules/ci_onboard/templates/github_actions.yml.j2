# ---------------------------------------------------------------
# GitHub Actions CI/CD Pipeline — Auto-generated by DevSecOps Assistant
# ---------------------------------------------------------------
name: CI/CD Pipeline

on:
  push:
    branches: [ "{{ deploy_branch }}" ]
  pull_request:
    branches: [ "{{ deploy_branch }}" ]

permissions:
  contents: read
{% if has_security_scan %}
  security-events: write
{% endif %}

jobs:
  # ==========================  BUILD & INSTALL  ==========================
  build:
    runs-on: ubuntu-latest
{% if docker_image %}
    container: {{ docker_image }}
{% endif %}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

{% if cache_paths %}
      - name: Cache dependencies
        uses: actions/cache@v4
        with:
          path: |
{% for cp in cache_paths %}
            {{ cp }}
{% endfor %}
          key: {% raw %}${{ runner.os }}{% endraw %}-{{ language }}-{% raw %}${{ hashFiles('**/*lock*', '**/requirements*.txt', '**/pom.xml', '**/build.gradle*', '**/go.sum', '**/Cargo.lock') }}{% endraw %}

{% endif %}
{% if install_cmd %}
      - name: Install dependencies
        run: {{ install_cmd }}
{% endif %}

{% if build_cmd %}
      - name: Build
        run: {{ build_cmd }}
{% endif %}

{% if has_lint and lint_cmd %}
      - name: Lint
        run: {{ lint_cmd }}
{% endif %}

{% if has_tests and test_cmd %}
      - name: Run tests
        run: {{ test_cmd }}
{% endif %}

{% if has_security_scan and security_cmd %}
  # ==========================  SECURITY SCAN  ==========================
  security:
    runs-on: ubuntu-latest
{% if docker_image %}
    container: {{ docker_image }}
{% endif %}
    needs: build

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

{% if install_cmd %}
      - name: Install dependencies
        run: {{ install_cmd }}
{% endif %}

      - name: Dependency security scan
        run: {{ security_cmd }}
        continue-on-error: true
{% endif %}

{% if has_docker %}
  # ==========================  DOCKER BUILD  ==========================
  docker:
    runs-on: ubuntu-latest
    needs: build
    if: {% raw %}github.ref == 'refs/heads/{{ deploy_branch }}' && github.event_name == 'push'{% endraw %}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Build Docker image
        run: |
          docker build -t app:{% raw %}${{ github.sha }}{% endraw %} .
          echo "Docker image built successfully"
{% endif %}
