# ---------------------------------------------------------------
# GitLab CI/CD Pipeline — Auto-generated by DevSecOps Assistant
# ---------------------------------------------------------------

stages:
  - build
{% if has_tests %}
  - test
{% endif %}
{% if has_lint and lint_cmd %}
  - lint
{% endif %}
{% if has_security_scan and security_cmd %}
  - security
{% endif %}
{% if has_docker %}
  - docker
{% endif %}

{% if docker_image %}
image: {{ docker_image }}
{% endif %}

{% if cache_paths %}
cache:
  paths:
{% for cp in cache_paths %}
    - {{ cp }}
{% endfor %}
{% endif %}

variables:
  GIT_DEPTH: "1"

# ==========================  BUILD  ==========================
build:
  stage: build
  script:
{% if install_cmd %}
    - {{ install_cmd }}
{% endif %}
{% if build_cmd %}
    - {{ build_cmd }}
{% else %}
    - echo "No build step required"
{% endif %}

{% if has_tests and test_cmd %}
# ==========================  TEST  ==========================
test:
  stage: test
  script:
{% if install_cmd %}
    - {{ install_cmd }}
{% endif %}
    - {{ test_cmd }}
{% endif %}

{% if has_lint and lint_cmd %}
# ==========================  LINT  ==========================
lint:
  stage: lint
  script:
{% if install_cmd %}
    - {{ install_cmd }}
{% endif %}
    - {{ lint_cmd }}
  allow_failure: true
{% endif %}

{% if has_security_scan and security_cmd %}
# ==========================  SECURITY  ==========================
security_scan:
  stage: security
  script:
{% if install_cmd %}
    - {{ install_cmd }}
{% endif %}
    - {{ security_cmd }}
  allow_failure: true
{% endif %}

{% if has_docker %}
# ==========================  DOCKER BUILD  ==========================
docker_build:
  stage: docker
  image: docker:latest
  services:
    - docker:dind
  only:
    - {{ deploy_branch }}
  script:
    - docker build -t app:$CI_COMMIT_SHORT_SHA .
    - echo "Docker image built successfully"
{% endif %}
