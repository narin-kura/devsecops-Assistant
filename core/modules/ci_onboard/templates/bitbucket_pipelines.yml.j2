# ---------------------------------------------------------------
# Bitbucket Pipelines — Auto-generated by DevSecOps Assistant
# ---------------------------------------------------------------

{% if docker_image %}
image: {{ docker_image }}
{% endif %}

pipelines:
  default:
    - step:
        name: 'Build & Test'
{% if cache_paths %}
        caches:
{% for cp in cache_paths %}
          - {{ cp | replace("/", "-") | replace("~", "home") | replace(".", "dot") }}
{% endfor %}
{% endif %}
        script:
{% if install_cmd %}
          - {{ install_cmd }}
{% endif %}
{% if build_cmd %}
          - {{ build_cmd }}
{% endif %}
{% if has_lint and lint_cmd %}
          - {{ lint_cmd }} || true
{% endif %}
{% if has_tests and test_cmd %}
          - {{ test_cmd }}
{% endif %}

{% if has_security_scan and security_cmd %}
    - step:
        name: 'Security Scan'
        script:
{% if install_cmd %}
          - {{ install_cmd }}
{% endif %}
          - {{ security_cmd }} || true
{% endif %}

{% if has_docker %}
  branches:
    {{ deploy_branch }}:
      - step:
          name: 'Build & Test'
          script:
{% if install_cmd %}
            - {{ install_cmd }}
{% endif %}
{% if build_cmd %}
            - {{ build_cmd }}
{% endif %}
{% if has_tests and test_cmd %}
            - {{ test_cmd }}
{% endif %}
      - step:
          name: 'Docker Build'
          services:
            - docker
          script:
            - docker build -t app:$BITBUCKET_BUILD_NUMBER .
            - echo "Docker image built successfully"
{% endif %}

definitions:
  services:
    docker:
      memory: 2048
